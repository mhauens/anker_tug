TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
TWITCH_REDIRECT_URI=http://localhost:8888/api/auth/callback
# Optional: restrict login to one numeric Twitch user ID. Leave empty to allow any account.
TWITCH_ALLOWED_USER_ID=
# 32 random bytes, base64 encoded. Example generator: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=
# Optional local visual/demo mode. Never enable this in production.
VITE_DEMO_MODE=false
